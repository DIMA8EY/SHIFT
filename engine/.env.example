# Ключ Anthropic — разбор расшифровки
ANTHROPIC_API_KEY=

# Yandex SpeechKit — расшифровка записи.
# Выбран потому, что звонки граждан РФ по 152-ФЗ лучше не вывозить за границу.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Без ключей движок работает в режиме mock: берёт готовую расшифровку
# из fixtures и показывает, что пайплайн живой. Ничего не выдумывает.
