# ======== Яндекс: всё можно сделать на одном облаке ========
# ID каталога (folder). Не секретный, но нужен в каждом запросе.
# Консоль → каталог «default» → Обзор → Идентификатор (начинается на b1g…)
YANDEX_FOLDER_ID=

# ВАЖНО: у ключей Yandex Cloud есть ОБЛАСТЬ ДЕЙСТВИЯ.
# Ключ работает только для своей области, один ключ на всё не годится.

# Область: yc.ai.speechkitStt.execute — распознавание записи
YANDEX_STT_KEY=

# Область: yc.ai.languageModels.execute — разбор расшифровки
YANDEX_GPT_KEY=

# Модель: yandexgpt — точнее, yandexgpt-lite — дешевле
YANDEX_GPT_MODEL=yandexgpt

# ======== Anthropic: не обязателен ========
# Если задан, разбор идёт через Claude: точнее, но второй счёт
# и трансграничная передача текста расшифровки.
ANTHROPIC_API_KEY=

# Без ключей движок работает в режиме mock: берёт готовую расшифровку
# из fixtures и показывает, что пайплайн живой. Ничего не выдумывает.
